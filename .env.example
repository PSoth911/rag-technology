# RAG Technology Lab - Environment Variables Example
# Copy this file to .env and adjust values for your local setup.

# FastAPI & Uvicorn Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL & pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_lab_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local LLM & Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
VISION_MODEL=qwen2.5-vl:7b

# OCR Configuration (Tesseract)
# On Windows, typical path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Embedding Model Cache Directory
HF_HOME=./.cache/huggingface
